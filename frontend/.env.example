# Frontend Environment Configuration
# For local development, these default to http://127.0.0.1:8000 and http://127.0.0.1:8001.
# In Cloud Build / Cloud Run deployments, set these to the deployed backend Cloud Run service URLs.
VITE_FLIGHTS_SEARCH_API_URL=http://127.0.0.1:8000
VITE_CONVERSATIONAL_API_URL=http://127.0.0.1:8001

# Optional warm secondary-region Cloud Run backend URLs for automatic client-side cross-region failover.
VITE_FLIGHTS_SEARCH_FALLBACK_API_URL=
VITE_CONVERSATIONAL_FALLBACK_API_URL=
