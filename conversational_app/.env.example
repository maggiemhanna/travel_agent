# Google Cloud & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=travel-agent-511710
GOOGLE_CLOUD_LOCATION=europe-west9
GOOGLE_API_USE_MTLS=never
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# AI Model Configuration (global default + optional per-sub-agent overrides)
GEMINI_MODEL=gemini-3.5-flash-lite
CONVERSATIONAL_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_LOCATION=global
# ENGAGE_MODEL=gemini-3.5-flash-lite
# FILTER_MODEL=gemini-3.5-flash-lite
# FILTER_SMART_MODEL=gemini-3.5-flash-lite
# INSPIRATION_MODEL=gemini-3.5-flash-lite
# JSON_PARSER_MODEL=gemini-3.5-flash-lite

# Main Server & CORS Configuration
HOST=0.0.0.0
PORT=8001
CONVERSATIONAL_BASE_URL=http://127.0.0.1:8001
ALLOWED_ORIGINS=*

# Standalone Sub-Agent Endpoints (used for local microservice & E2E testing)
SUB_AGENT_HOST=127.0.0.1
ENGAGE_BASE_URL=http://127.0.0.1:8002
FILTER_BASE_URL=http://127.0.0.1:8003
FILTER_SMART_BASE_URL=http://127.0.0.1:8004
INSPIRATION_BASE_URL=http://127.0.0.1:8005
JSON_PARSER_BASE_URL=http://127.0.0.1:8006
