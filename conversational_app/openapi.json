{
  "components": {
    "schemas": {
      "ConversationalInput": {
        "description": "Input schema for the Conversational Agent.",
        "properties": {
          "conversational_history": {
            "description": "Optional initial conversation history where each string is formatted as 'role: message' (e.g., 'bot: Hello' or 'user: flights under $500'). Managed automatically by the backend across turns when session_id is reused.",
            "items": {
              "type": "string"
            },
            "title": "Conversational History",
            "type": "array"
          },
          "flights_input": {
            "description": "The flights to filter.",
            "items": {
              "$ref": "#/components/schemas/Flight"
            },
            "title": "Flights Input",
            "type": "array"
          },
          "flights_search_input": {
            "$ref": "#/components/schemas/FlightParams",
            "description": "The flights search input."
          },
          "session_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional server-managed session identifier to continue an existing multi-turn conversation. Omit to start a new session.",
            "title": "Session Id"
          },
          "user_message": {
            "description": "The message from the user.",
            "maxLength": 4000,
            "minLength": 1,
            "title": "User Message",
            "type": "string"
          }
        },
        "required": [
          "user_message",
          "flights_search_input"
        ],
        "title": "ConversationalInput",
        "type": "object"
      },
      "ConversationalOutput": {
        "description": "Output schema for the Conversational Agent.",
        "properties": {
          "agent_decision": {
            "description": "The decision of the agent.",
            "enum": [
              "filter",
              "filter_smart",
              "inspiration",
              "continue"
            ],
            "title": "Agent Decision",
            "type": "string"
          },
          "agent_response": {
            "description": "The response from the agent.",
            "title": "Agent Response",
            "type": "string"
          },
          "filter_type": {
            "anyOf": [
              {
                "enum": [
                  "direct",
                  "max_price",
                  "max_stops"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The type of filter to apply.",
            "title": "Filter Type"
          },
          "filter_value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The value of the filter to apply.",
            "title": "Filter Value"
          },
          "flights_output": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Flight"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "The flights filtered by the smart filter.",
            "title": "Flights Output"
          },
          "flights_search_output": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FlightParams"
              },
              {
                "type": "null"
              }
            ],
            "description": "The flights search output."
          }
        },
        "required": [
          "agent_response",
          "agent_decision"
        ],
        "title": "ConversationalOutput",
        "type": "object"
      },
      "ConversationalResponse": {
        "description": "HTTP response envelope for POST /api/v1/run-conversational (and legacy /run-conversational).",
        "properties": {
          "results": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConversationalOutput"
              },
              {
                "$ref": "#/components/schemas/RawTextFallback"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "description": "Normalized multi-agent workflow output (or graceful plain-text fallback).",
            "title": "Results"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Server-managed session identifier to send on subsequent turns.",
            "title": "Session Id"
          },
          "status": {
            "const": "success",
            "default": "success",
            "description": "Execution status indicator.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "results"
        ],
        "title": "ConversationalResponse",
        "type": "object"
      },
      "Flight": {
        "properties": {
          "airline": {
            "description": "The airline of the flight.",
            "title": "Airline",
            "type": "string"
          },
          "arrival_time": {
            "description": "The arrival time for the flight search.",
            "title": "Arrival Time",
            "type": "string"
          },
          "departure_date": {
            "description": "The departure date for the flight search.",
            "title": "Departure Date",
            "type": "string"
          },
          "departure_time": {
            "description": "The departure time for the flight search.",
            "title": "Departure Time",
            "type": "string"
          },
          "destination": {
            "description": "The destination city for the flight search.",
            "title": "Destination",
            "type": "string"
          },
          "flight_number": {
            "description": "The flight number of the flight.",
            "title": "Flight Number",
            "type": "string"
          },
          "origin": {
            "description": "The origin city for the flight search.",
            "title": "Origin",
            "type": "string"
          },
          "price": {
            "description": "The price of the flight.",
            "title": "Price",
            "type": "string"
          },
          "return_arrival_time": {
            "description": "The return arrival time for the flight search.",
            "title": "Return Arrival Time",
            "type": "string"
          },
          "return_date": {
            "description": "The return date for the flight search.",
            "title": "Return Date",
            "type": "string"
          },
          "return_time": {
            "description": "The return time for the flight search.",
            "title": "Return Time",
            "type": "string"
          },
          "stopover_cities": {
            "description": "The cities where the flight stops.",
            "items": {
              "type": "string"
            },
            "title": "Stopover Cities",
            "type": "array"
          },
          "stops": {
            "description": "The number of stops on the flight.",
            "minimum": 0.0,
            "title": "Stops",
            "type": "integer"
          }
        },
        "required": [
          "origin",
          "destination",
          "departure_date",
          "return_date",
          "departure_time",
          "arrival_time",
          "return_time",
          "return_arrival_time",
          "price",
          "airline",
          "flight_number",
          "stops",
          "stopover_cities"
        ],
        "title": "Flight",
        "type": "object"
      },
      "FlightParams": {
        "properties": {
          "departure_date": {
            "description": "The departure date for the flight search.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Departure Date",
            "type": "string"
          },
          "destination": {
            "description": "The destination city for the flight search.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Destination",
            "type": "string"
          },
          "origin": {
            "description": "The origin city for the flight search.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Origin",
            "type": "string"
          },
          "passengers": {
            "description": "The number of passengers for the flight search.",
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Passengers",
            "type": "integer"
          },
          "return_date": {
            "description": "The return date for the flight search.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Return Date",
            "type": "string"
          }
        },
        "required": [
          "origin",
          "destination",
          "departure_date",
          "return_date",
          "passengers"
        ],
        "title": "FlightParams",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "description": "HTTP 200 liveness payload contract for GET /healthz.",
        "properties": {
          "service": {
            "description": "Logical Cloud Run service identifier.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "description": "Liveness status indicator.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "RawTextFallback": {
        "additionalProperties": false,
        "description": "Fallback payload returned when an upstream LLM emits non-JSON plain text.",
        "properties": {
          "raw_text": {
            "description": "Unparsed plain-text response returned safely when JSON decoding fails.",
            "title": "Raw Text",
            "type": "string"
          }
        },
        "required": [
          "raw_text"
        ],
        "title": "RawTextFallback",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "HTTP 200 readiness payload contract for GET /readyz.",
        "properties": {
          "fallback_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Configured automatic backup Gemini model, when enabled.",
            "title": "Fallback Model"
          },
          "models": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Configured primary Gemini models keyed by agent role.",
            "title": "Models",
            "type": "object"
          },
          "service": {
            "description": "Logical Cloud Run service identifier.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "description": "Readiness status indicator.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "models"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RootInfoResponse": {
        "description": "Informational root endpoint banner payload.",
        "properties": {
          "message": {
            "description": "Service status banner message.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "RootInfoResponse",
        "type": "object"
      },
      "SessionDeleteResponse": {
        "description": "HTTP response payload for DELETE /api/v1/sessions/{session_id}.",
        "properties": {
          "session_id": {
            "description": "The targeted session identifier.",
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "description": "Whether an active in-memory session was found and deleted.",
            "enum": [
              "deleted",
              "not_found"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "session_id"
        ],
        "title": "SessionDeleteResponse",
        "type": "object"
      },
      "UnreadyResponse": {
        "description": "HTTP 503 readiness failure contract for GET /readyz.",
        "properties": {
          "errors": {
            "description": "Startup or configuration validation errors.",
            "items": {
              "type": "string"
            },
            "title": "Errors",
            "type": "array"
          },
          "service": {
            "description": "Logical Cloud Run service identifier.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "not_ready",
            "default": "not_ready",
            "description": "Unready status indicator.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "errors"
        ],
        "title": "UnreadyResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API for running the Conversational Agent.",
    "title": "Conversational Agent Service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootInfoResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/run-conversational": {
      "post": {
        "description": "Triggers the conversational workflow with the provided user input.\nMaintains multi-turn conversation history server-side in memory keyed by session_id.",
        "operationId": "run_conversational_v1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationalInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Conversational",
        "tags": [
          "Agent v1"
        ]
      }
    },
    "/api/v1/sessions/{session_id}": {
      "delete": {
        "description": "Deletes an active in-memory conversation session.",
        "operationId": "delete_session_v1",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDeleteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Session",
        "tags": [
          "Agent v1"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Cloud Run liveness probe endpoint.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "Health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Cloud Run startup/readiness probe endpoint.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readyz",
        "tags": [
          "Health"
        ]
      }
    },
    "/run-conversational": {
      "post": {
        "deprecated": true,
        "description": "Triggers the conversational workflow with the provided user input.\nMaintains multi-turn conversation history server-side in memory keyed by session_id.",
        "operationId": "run_conversational_legacy",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationalInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Conversational",
        "tags": [
          "Agent (Legacy)"
        ]
      }
    }
  }
}
