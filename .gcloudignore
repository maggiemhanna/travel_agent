# Ignore virtual environments, Node modules, Git history, and large eval artifacts
# when uploading source context to Google Cloud Build.
.git/
.gitignore
.venv/
.node/
**/__pycache__/
*.py[cod]
*$py.class
**/.pytest_cache/
**/.DS_Store
**/.env
**/.env.*
!/**/.env.example
frontend/node_modules/
frontend/dist/
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
conversational_app/tests/eval/results/
architecture.excalidraw
architecture.png
