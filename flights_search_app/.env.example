# Google Cloud & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=travel-agent-511710
GOOGLE_CLOUD_LOCATION=europe-west9
GOOGLE_API_USE_MTLS=never
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# AI Model Configuration
GEMINI_MODEL=gemini-3.5-flash-lite
FLIGHTS_SEARCH_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_LOCATION=global

# Server & Endpoint Configuration
HOST=0.0.0.0
PORT=8000
FLIGHTS_SEARCH_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=*
