{
  "components": {
    "schemas": {
      "Filters": {
        "description": "The structure for the user's initial filters.",
        "properties": {
          "direct": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the flight should be direct.",
            "title": "Direct"
          },
          "max_price": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The maximum price of the flight.",
            "title": "Max Price"
          },
          "max_stops": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The maximum number of stops on the flight.",
            "title": "Max Stops"
          }
        },
        "title": "Filters",
        "type": "object"
      },
      "Flight": {
        "properties": {
          "airline": {
            "description": "The airline of the flight.",
            "title": "Airline",
            "type": "string"
          },
          "arrival_time": {
            "description": "The arrival time for the flight search.",
            "title": "Arrival Time",
            "type": "string"
          },
          "departure_date": {
            "description": "The departure date for the flight search.",
            "title": "Departure Date",
            "type": "string"
          },
          "departure_time": {
            "description": "The departure time for the flight search.",
            "title": "Departure Time",
            "type": "string"
          },
          "destination": {
            "description": "The destination city for the flight search.",
            "title": "Destination",
            "type": "string"
          },
          "flight_number": {
            "description": "The flight number of the flight.",
            "title": "Flight Number",
            "type": "string"
          },
          "origin": {
            "description": "The origin city for the flight search.",
            "title": "Origin",
            "type": "string"
          },
          "price": {
            "description": "The price of the flight.",
            "title": "Price",
            "type": "string"
          },
          "return_arrival_time": {
            "description": "The return arrival time for the flight search.",
            "title": "Return Arrival Time",
            "type": "string"
          },
          "return_date": {
            "description": "The return date for the flight search.",
            "title": "Return Date",
            "type": "string"
          },
          "return_time": {
            "description": "The return time for the flight search.",
            "title": "Return Time",
            "type": "string"
          },
          "stopover_cities": {
            "description": "The cities where the flight stops.",
            "items": {
              "type": "string"
            },
            "title": "Stopover Cities",
            "type": "array"
          },
          "stops": {
            "description": "The number of stops on the flight.",
            "title": "Stops",
            "type": "integer"
          }
        },
        "required": [
          "origin",
          "destination",
          "departure_date",
          "return_date",
          "departure_time",
          "arrival_time",
          "return_time",
          "return_arrival_time",
          "price",
          "airline",
          "flight_number",
          "stops",
          "stopover_cities"
        ],
        "title": "Flight",
        "type": "object"
      },
      "FlightsSearchInput": {
        "description": "The structure for the user's raw request provided to the Flight Search agent.",
        "properties": {
          "departure_date": {
            "description": "The departure date for the flight search.",
            "title": "Departure Date",
            "type": "string"
          },
          "destination": {
            "description": "The destination city for the flight search.",
            "title": "Destination",
            "type": "string"
          },
          "filters": {
            "$ref": "#/components/schemas/Filters",
            "description": "The filters for the flight search."
          },
          "origin": {
            "description": "The origin city for the flight search.",
            "title": "Origin",
            "type": "string"
          },
          "passengers": {
            "description": "The number of passengers for the flight search.",
            "title": "Passengers",
            "type": "integer"
          },
          "return_date": {
            "description": "The return date for the flight search.",
            "title": "Return Date",
            "type": "string"
          }
        },
        "required": [
          "origin",
          "destination",
          "departure_date",
          "return_date",
          "passengers"
        ],
        "title": "FlightsSearchInput",
        "type": "object"
      },
      "FlightsSearchOutput": {
        "description": "The structure for the final output of the flight search agent.",
        "properties": {
          "flights": {
            "description": "A list of flights that match the search criteria.",
            "items": {
              "$ref": "#/components/schemas/Flight"
            },
            "title": "Flights",
            "type": "array"
          }
        },
        "required": [
          "flights"
        ],
        "title": "FlightsSearchOutput",
        "type": "object"
      },
      "FlightsSearchResponse": {
        "description": "HTTP response envelope for POST /api/v1/run-flights-search (and legacy /run-flights-search).",
        "properties": {
          "results": {
            "description": "Structured flight search output items (or graceful plain-text fallback).",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/FlightsSearchOutput"
                },
                {
                  "$ref": "#/components/schemas/RawTextFallback"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                }
              ]
            },
            "title": "Results",
            "type": "array"
          },
          "status": {
            "const": "success",
            "default": "success",
            "description": "Execution status indicator.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "results"
        ],
        "title": "FlightsSearchResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "description": "HTTP 200 liveness payload contract for GET /healthz.",
        "properties": {
          "service": {
            "description": "Logical Cloud Run service identifier.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "description": "Liveness status indicator.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "RawTextFallback": {
        "additionalProperties": false,
        "description": "Fallback payload returned when an upstream LLM emits non-JSON plain text.",
        "properties": {
          "raw_text": {
            "description": "Unparsed plain-text response returned safely when JSON decoding fails.",
            "title": "Raw Text",
            "type": "string"
          }
        },
        "required": [
          "raw_text"
        ],
        "title": "RawTextFallback",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "HTTP 200 readiness payload contract for GET /readyz.",
        "properties": {
          "fallback_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Configured automatic backup Gemini model, when enabled.",
            "title": "Fallback Model"
          },
          "models": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Configured primary Gemini models keyed by agent role.",
            "title": "Models",
            "type": "object"
          },
          "service": {
            "description": "Logical Cloud Run service identifier.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "description": "Readiness status indicator.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "models"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RootInfoResponse": {
        "description": "Informational root endpoint banner payload.",
        "properties": {
          "message": {
            "description": "Service status banner message.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "RootInfoResponse",
        "type": "object"
      },
      "UnreadyResponse": {
        "description": "HTTP 503 readiness failure contract for GET /readyz.",
        "properties": {
          "errors": {
            "description": "Startup or configuration validation errors.",
            "items": {
              "type": "string"
            },
            "title": "Errors",
            "type": "array"
          },
          "service": {
            "description": "Logical Cloud Run service identifier.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "not_ready",
            "default": "not_ready",
            "description": "Unready status indicator.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "errors"
        ],
        "title": "UnreadyResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API for running the Flights Search Agent.",
    "title": "Flights Search Agent Service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootInfoResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/run-flights-search": {
      "post": {
        "description": "Triggers the flights search agent with the provided user input.\nThe response will contain the structured JSON output from the agent.",
        "operationId": "run_flights_search_v1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlightsSearchInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightsSearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Flights Search",
        "tags": [
          "Agent v1"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Cloud Run liveness probe endpoint.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "Health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Cloud Run startup/readiness probe endpoint.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readyz",
        "tags": [
          "Health"
        ]
      }
    },
    "/run-flights-search": {
      "post": {
        "deprecated": true,
        "description": "Triggers the flights search agent with the provided user input.\nThe response will contain the structured JSON output from the agent.",
        "operationId": "run_flights_search_legacy",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlightsSearchInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightsSearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Flights Search",
        "tags": [
          "Agent (Legacy)"
        ]
      }
    }
  }
}
